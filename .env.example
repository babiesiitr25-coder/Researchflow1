# Create a PostgreSQL database in Replit and set DATABASE_URL in Secrets.
DATABASE_URL=postgresql://user:password@localhost:5432/researchflow
SESSION_SECRET=replace-with-a-long-cryptographically-random-string
OWNER_EMAIL=you@example.edu
OWNER_PASSWORD=replace-with-unique-long-password
OWNER_NAME=Principal Researcher
# Optional: Enables real AI-agent interpretation. Without it, basic quick commands still work.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Only set if your PostgreSQL provider requires TLS:
PGSSL=false
PORT=3000
NODE_ENV=production
